#!/usr/bin/env bash
set -Eeuo pipefail

archive=${1:-}
image=${2:-$(docker inspect animal-farts --format '{{.Config.Image}}' 2>/dev/null)}
[[ -n $archive && -f $archive ]] || { echo 'usage: animal-farts-restore-rehearsal BACKUP_ARCHIVE [IMAGE]' >&2; exit 2; }
[[ -n $image ]] || { echo 'an image argument or running animal-farts container is required' >&2; exit 2; }

work=$(mktemp -d /tmp/animal-farts-restore-XXXXXX)
name="animal-farts-restore-$$"
cleanup() {
  docker rm -f "$name" >/dev/null 2>&1 || true
  rm -rf -- "$work"
}
trap cleanup EXIT
tar -C "$work" -xzf "$archive"
(cd "$work" && sha256sum --check manifest.sha256 >/dev/null)
[[ $(sqlite3 "$work/farts.db" 'PRAGMA integrity_check;') == ok ]]

expected=$(cat "$work/recording-count.txt")
actual=$(sqlite3 "$work/farts.db" 'SELECT COUNT(*) FROM recordings;')
[[ $actual == "$expected" ]] || { echo "recording count mismatch: expected $expected, got $actual" >&2; exit 1; }

# The production image runs as UID 1000. Grant that user ownership of this
# disposable restore tree just as the real deployment does for /app/data.
chown -R 1000:1000 "$work"
chmod 0750 "$work"

docker run -d --rm --name "$name" \
  -p 127.0.0.1::3000 \
  -v "$work:/app/data" \
  -e NODE_ENV=production -e SOCIAL_FEATURES_ENABLED=0 \
  -e DB_PATH=/app/data/farts.db -e UPLOAD_DIR=/app/data/uploads -e PORT=3000 \
  "$image" >/dev/null
port=$(docker inspect "$name" --format '{{(index (index .NetworkSettings.Ports "3000/tcp") 0).HostPort}}')
for _ in $(seq 1 30); do
  if curl --fail --silent --max-time 3 "http://127.0.0.1:$port/api/health" | grep -q '"ok":true'; then break; fi
  sleep 1
done
curl --fail --silent --max-time 5 "http://127.0.0.1:$port/api/health" | grep -q '"ok":true'

audio_file=$(sqlite3 "$work/farts.db" "SELECT filename FROM recordings WHERE filename <> '' ORDER BY id LIMIT 1;")
if [[ -n $audio_file ]]; then
  [[ $audio_file != */* && $audio_file != *..* ]] || { echo 'unsafe audio filename in restored database' >&2; exit 1; }
  curl --fail --silent --max-time 5 "http://127.0.0.1:$port/uploads/$audio_file" -o /dev/null
fi
printf 'RESTORE_REHEARSAL=ok\nIMAGE=%s\nRECORDINGS=%s\nAUDIO_CHECK=%s\n' "$image" "$actual" "$([[ -n $audio_file ]] && echo played || echo no-recordings)"
