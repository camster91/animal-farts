[Unit]
Description=Privacy-safe Animal Farts production checks
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/animal-farts-ops.env
ExecStart=/usr/local/sbin/animal-farts-ops-check
PrivateTmp=true
NoNewPrivileges=true
